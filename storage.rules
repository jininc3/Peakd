rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // Posts: users can only upload to their own folder and read all posts
    match /posts/{userId}/{fileName} {
      // Anyone can read posts
      allow read: if true;

      // Only authenticated users can create/update to their own folder
      // Limit file size to 50MB and validate content type
      allow create, update: if request.auth != null
                            && request.auth.uid == userId
                            && request.resource.size < 50 * 1024 * 1024
                            && (request.resource.contentType.matches('image/.*')
                                || request.resource.contentType.matches('video/.*'));

      // Allow users to delete their own posts
      allow delete: if request.auth != null
                    && request.auth.uid == userId;
    }

    // Profile images: users can only upload to their own folder
    match /profiles/{userId}/{fileName} {
      allow read: if true;

      // Limit profile images to 10MB and only images
      allow create, update: if request.auth != null
                            && request.auth.uid == userId
                            && request.resource.size < 10 * 1024 * 1024
                            && request.resource.contentType.matches('image/.*');

      // Allow users to delete their own profile images
      allow delete: if request.auth != null
                    && request.auth.uid == userId;
    }

    // Profile pictures: users can only upload to their own folder
    match /profile-pictures/{userId}/{fileName} {
      allow read: if true;

      // Limit profile pictures to 10MB and only images
      allow create, update: if request.auth != null
                            && request.auth.uid == userId
                            && request.resource.size < 10 * 1024 * 1024
                            && request.resource.contentType.matches('image/.*');

      // Allow users to delete their own profile pictures
      allow delete: if request.auth != null
                    && request.auth.uid == userId;
    }

    // Cover photos: users can only upload to their own folder
    match /cover-photos/{userId}/{fileName} {
      allow read: if true;

      // Limit cover photos to 10MB and only images
      allow create, update: if request.auth != null
                            && request.auth.uid == userId
                            && request.resource.size < 10 * 1024 * 1024
                            && request.resource.contentType.matches('image/.*');

      // Allow users to delete their own cover photos
      allow delete: if request.auth != null
                    && request.auth.uid == userId;
    }

    // Party cover photos: authenticated users can upload party covers.
    // `**` for the same client path mismatch described under party-icons.
    match /party-covers/{allPaths=**} {
      allow read: if true;

      // Limit party covers to 10MB and only images
      allow create, update: if request.auth != null
                            && request.resource.size < 10 * 1024 * 1024
                            && request.resource.contentType.matches('image/.*');

      // Allow authenticated users to delete party covers
      allow delete: if request.auth != null;
    }

    // Party icons: authenticated users can upload party icons.
    //
    // `**` because the two clients use different layouts: mobile writes
    // party-icons/{partyId}.jpg (one segment) while web writes
    // party-icons/{partyId}/icon.{ext} (two). A single-segment match silently
    // sent every web upload to the default-deny rule at the bottom of this
    // file, and createLobbyService swallows the error — so custom icons
    // appeared to "work" while always falling back to a default.
    match /party-icons/{allPaths=**} {
      allow read: if true;

      // Limit party icons to 5MB and only images
      allow create, update: if request.auth != null
                            && request.resource.size < 5 * 1024 * 1024
                            && request.resource.contentType.matches('image/.*');

      // Allow authenticated users to delete party icons
      allow delete: if request.auth != null;
    }

    // Default: deny all other access
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
