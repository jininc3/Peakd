rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Users collection - users can read all profiles but only write their own
    match /users/{userId} {
      allow read: if true;

      // Allow users to write their own profile
      allow write: if request.auth != null && request.auth.uid == userId;

      // Allow updating follower/following counts when someone follows/unfollows
      allow update: if request.auth != null
                    && (
                      // User updating their own profile
                      request.auth.uid == userId
                      // OR incrementing/decrementing follower counts only
                      || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['followersCount', 'followingCount', 'postsCount']))
                      // OR updating push notification token (for user's own profile only)
                      || (request.auth.uid == userId && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['expoPushToken', 'pushTokenUpdatedAt']))
                    );

      // Followers subcollection - who follows this user
      match /followers/{followerId} {
        // Anyone can read followers
        allow read: if true;

        // The follower can create their follow, OR the target user can create when accepting a follow request
        allow create: if request.auth != null
                      && request.resource.data.followerId == followerId
                      && request.resource.data.followerUsername is string
                      && request.resource.data.createdAt is timestamp
                      && (request.auth.uid == followerId || request.auth.uid == userId);

        // Allow the follower to delete their own follow OR the user to delete from their own followers list
        allow delete: if request.auth != null
                      && (request.auth.uid == followerId || request.auth.uid == userId);
      }

      // Following subcollection - who this user follows
      match /following/{followingId} {
        // Anyone can read following
        allow read: if true;

        // The user can create their following, OR the followed user can create when accepting a follow request
        allow create: if request.auth != null
                      && request.resource.data.followingId == followingId
                      && request.resource.data.followingUsername is string
                      && request.resource.data.createdAt is timestamp
                      && (request.auth.uid == userId || request.auth.uid == followingId);

        // Allow the user to delete their own following OR the followed user to remove them
        allow delete: if request.auth != null
                      && (request.auth.uid == userId || request.auth.uid == followingId);
      }

      // Follow requests subcollection - pending follow requests for private accounts
      match /followRequests/{requesterId} {
        // Target user can read all their follow requests, requester can read their own request
        allow read: if request.auth != null
                    && (request.auth.uid == userId || request.auth.uid == requesterId);

        // The requester can create their own request
        allow create: if request.auth != null
                      && request.auth.uid == requesterId
                      && request.resource.data.requesterId == requesterId
                      && request.resource.data.requesterUsername is string
                      && request.resource.data.createdAt is timestamp;

        // Target user can delete (accept/decline), OR requester can cancel
        allow delete: if request.auth != null
                      && (request.auth.uid == userId || request.auth.uid == requesterId);
      }

      // Reported posts subcollection - tracks which posts a user reported (for feed hiding)
      match /reportedPosts/{postId} {
        allow read: if request.auth != null && request.auth.uid == userId;

        allow create: if request.auth != null
                      && request.auth.uid == userId
                      && request.resource.data.postId == postId
                      && request.resource.data.createdAt is timestamp;
      }

      // Blocked users subcollection - who this user has blocked
      match /blockedUsers/{blockedUserId} {
        allow read: if request.auth != null && request.auth.uid == userId;

        allow create: if request.auth != null
                      && request.auth.uid == userId
                      && request.resource.data.blockedUserId == blockedUserId
                      && request.resource.data.blockedUsername is string
                      && request.resource.data.createdAt is timestamp;

        allow delete: if request.auth != null
                      && request.auth.uid == userId;
      }

      // Blocked-by subcollection - reverse index of who has blocked this user
      match /blockedByUsers/{blockerUserId} {
        allow read: if request.auth != null
                    && (request.auth.uid == userId || request.auth.uid == blockerUserId);

        allow create: if request.auth != null
                      && request.auth.uid == blockerUserId
                      && request.resource.data.blockerUserId == blockerUserId
                      && request.resource.data.createdAt is timestamp;

        allow delete: if request.auth != null
                      && request.auth.uid == blockerUserId;
      }

      // Search history subcollection - user's recent searches
      match /searchHistory/{searchedUserId} {
        // Only the user can read their own search history
        allow read: if request.auth != null && request.auth.uid == userId;

        // Only the user can write to their own search history
        allow write: if request.auth != null && request.auth.uid == userId;
      }

      // Notifications subcollection - user's notifications
      match /notifications/{notificationId} {
        // Only the user can read their own notifications
        allow read: if request.auth != null && request.auth.uid == userId;

        // Only the user can update/delete their own notifications
        allow update, delete: if request.auth != null && request.auth.uid == userId;

        // Any authenticated user can create notifications (for others)
        allow create: if request.auth != null
                      && request.resource.data.type in ['follow', 'like', 'comment', 'tag', 'party_invite', 'challenge_invite', 'party_complete', 'party_ranking_change', 'achievement', 'follow_request']
                      && request.resource.data.read is bool
                      && request.resource.data.createdAt is timestamp;
      }

      // Game stats subcollection - user's game statistics
      match /gameStats/{game} {
        // Allow anyone to read game stats (needed for leaderboards)
        allow read: if true;

        // Only the user can write their own game stats
        allow write: if request.auth != null && request.auth.uid == userId;
      }

      // Badges subcollection - earned achievement badges
      match /badges/{badgeId} {
        // Anyone can read badges (shown on public profiles)
        allow read: if true;
        // Writes handled by cloud functions via Admin SDK
      }

      // Rank history subcollection - daily LP/RR snapshots for graphs
      match /rankHistory/{docId} {
        // Anyone can read rank history (for viewing other users' profiles)
        allow read: if true;
        // Writes handled by cloud functions via Admin SDK
      }

      // Season peaks subcollection - per-season peak rank cards (web + mobile)
      match /seasonPeaks/{peakId} {
        // Anyone can read (public card collections on profiles)
        allow read: if true;

        // Only the user can write their own season peaks
        // (the Valorant act-history cloud function writes via Admin SDK)
        allow write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Posts collection
    match /posts/{postId} {
      // Anyone can read posts
      allow read: if true;

      // Only authenticated users can create posts (max 5 posts per user)
      allow create: if request.auth != null
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.keys().hasAll(['userId', 'username', 'mediaUrl', 'mediaType', 'createdAt', 'likes'])
                    && request.resource.data.mediaType in ['image', 'video']
                    && request.resource.data.likes is number
                    && request.resource.data.createdAt is timestamp
                    // Enforce 5-post limit - check user's current post count
                    && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.postsCount < 5;

      // Allow owner to update their posts OR anyone to update likes/commentsCount
      allow update: if request.auth != null
                    && (
                      // Owner can edit their post
                      (resource.data.userId == request.auth.uid
                       && request.resource.data.userId == resource.data.userId
                       && request.resource.data.createdAt == resource.data.createdAt)
                      // Anyone can increment/decrement likes or commentsCount
                      || request.resource.data.diff(resource.data)
                         .affectedKeys().hasOnly(['likes', 'commentsCount'])
                    );

      allow delete: if request.auth != null
                    && resource.data.userId == request.auth.uid;

      // Likes subcollection
      match /likes/{userId} {
        // Anyone can read likes
        allow read: if true;

        // Only the user can create their own like
        allow create: if request.auth != null
                      && request.auth.uid == userId
                      && request.resource.data.userId == userId
                      && request.resource.data.username is string
                      && request.resource.data.likedAt is timestamp;

        // Allow the user to delete their own like OR the post owner to delete any like on their post
        allow delete: if request.auth != null
                      && (request.auth.uid == userId || request.auth.uid == get(/databases/$(database)/documents/posts/$(postId)).data.userId);
      }

      // Comments subcollection
      match /comments/{commentId} {
        // Anyone can read comments
        allow read: if true;

        // Any authenticated user can create a comment
        allow create: if request.auth != null
                      && request.resource.data.userId == request.auth.uid
                      && request.resource.data.username is string
                      && request.resource.data.text is string
                      && request.resource.data.text.size() > 0
                      && request.resource.data.text.size() <= 500
                      && request.resource.data.createdAt is timestamp;

        // Allow the comment author to delete their own comment OR the post owner to delete any comment on their post
        allow delete: if request.auth != null
                      && (request.auth.uid == resource.data.userId || request.auth.uid == get(/databases/$(database)/documents/posts/$(postId)).data.userId);
      }
    }

    // Chats collection
    match /chats/{chatId} {
      // Allow read if user is a participant
      allow read: if request.auth != null
                     && request.auth.uid in resource.data.participants;

      // Allow create if user is one of the participants
      allow create: if request.auth != null
                       && request.auth.uid in request.resource.data.participants
                       && request.resource.data.participants.size() == 2
                       && request.resource.data.keys().hasAll(['participants', 'participantDetails', 'lastMessage', 'lastMessageTimestamp', 'lastMessageSenderId', 'unreadCount', 'createdAt'])
                       && request.resource.data.createdAt is timestamp;

      // Allow update if user is a participant (for updating last message, unread counts)
      allow update: if request.auth != null
                       && request.auth.uid in resource.data.participants;

      // Allow delete if user is a participant
      allow delete: if request.auth != null
                       && request.auth.uid in resource.data.participants;

      // Messages subcollection
      match /messages/{messageId} {
        // Allow read if user is a participant of the chat
        allow read: if request.auth != null
                       && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;

        // Allow create if user is a participant and is the sender
        allow create: if request.auth != null
                         && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants
                         && request.auth.uid == request.resource.data.senderId
                         && request.resource.data.text is string
                         && request.resource.data.text.size() > 0
                         && request.resource.data.text.size() <= 500
                         && request.resource.data.timestamp is timestamp
                         && request.resource.data.read is bool;

        // Allow update if user is a participant (for marking messages as read)
        allow update: if request.auth != null
                         && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;

        // Allow delete if user is the sender or a participant in the chat
        allow delete: if request.auth != null
                         && (request.auth.uid == resource.data.senderId
                             || request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants);
      }
    }

    // Parties collection - leaderboard parties
    match /parties/{partyId} {
      // Any authenticated user can read parties (invites, leaderboards, join
      // by code). Open lobbies are also readable signed-out so the home page
      // can surface them to new visitors; list queries must filter on
      // visibility == "public" to satisfy this.
      allow read: if request.auth != null || resource.data.visibility == "public";

      // Allow creating if authenticated and user is the creator
      allow create: if request.auth != null &&
                       request.auth.uid == request.resource.data.createdBy &&
                       request.auth.uid in request.resource.data.members;

      // Allow updating if user is already a member OR joining via invite
      // (adding self to members).
      //
      // Lobby identity — name, icon, cover, visibility — is owner-only: the
      // settings UI already hides those controls from non-owners, but without
      // this any member could rename a lobby or replace its icon straight
      // through the API. Every other field stays member-writable so joins,
      // leaves, kicks, invites and challenge flows are unaffected.
      allow update: if request.auth != null &&
                       (request.auth.uid in resource.data.members ||
                        request.auth.uid in request.resource.data.members) &&
                       (
                         !request.resource.data.diff(resource.data)
                           .affectedKeys()
                           .hasAny(['partyName', 'partyIcon', 'coverPhoto', 'visibility']) ||
                         request.auth.uid == resource.data.createdBy
                       );

      // Allow deleting if user is the creator
      allow delete: if request.auth != null &&
                       request.auth.uid == resource.data.createdBy;
    }

    // Duo Queue collection - for live matchmaking
    match /duoQueue/{queueId} {
      // Users can read their own queue entry (needed for onSnapshot listener)
      allow read: if request.auth != null
                  && resource.data.userId == request.auth.uid;

      // Users can create their own queue entry
      allow create: if request.auth != null
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.game in ['valorant', 'league']
                    && request.resource.data.status == 'searching';

      // Users can update their own queue entry
      allow update: if request.auth != null
                    && resource.data.userId == request.auth.uid;

      // Users can delete their own queue entry (leave queue)
      // Uses doc ID pattern to avoid permission errors when doc already deleted by cleanup
      allow delete: if request.auth != null
                    && queueId.matches(request.auth.uid + '_.*');
    }

    // Duo Matches collection - matched duo pairs
    match /duoMatches/{matchId} {
      // Users can read matches they are part of
      allow read: if request.auth != null
                  && (resource.data.user1Id == request.auth.uid
                      || resource.data.user2Id == request.auth.uid);

      // Users can update matches they are part of (accept/decline)
      allow update: if request.auth != null
                    && (resource.data.user1Id == request.auth.uid
                        || resource.data.user2Id == request.auth.uid);
    }

    // Duo Posts collection - time-limited duo card posts in the feed
    match /duoPosts/{postId} {                                                                                                // Anyone can read duo posts
    allow read: if true;

      // Only the post owner can create (postId must match userId_game pattern)
      allow create: if request.auth != null
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.game in ['valorant', 'league']
                    && request.resource.data.status == 'active';

      // Owner can update (re-post resets timer)
      allow update: if request.auth != null
                    && resource.data.userId == request.auth.uid;

      // Owner can delete their post
      allow delete: if request.auth != null
                    && resource.data.userId == request.auth.uid;
    }

    // Duo Cards collection - for finding duo partners
    match /duoCards/{cardId} {
      // Anyone authenticated can read duo cards (to find partners)
      allow read: if request.auth != null;

      // Only the card owner can create their own duo card
      allow create: if request.auth != null
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.keys().hasAll(['userId', 'game', 'username', 'currentRank', 'region', 'mainRole', 'peakRank', 'mainAgent', 'createdAt', 'updatedAt', 'status'])
                    && request.resource.data.game in ['valorant', 'league']
                    && request.resource.data.status == 'active'
                    && request.resource.data.createdAt is timestamp
                    && request.resource.data.updatedAt is timestamp;

      // Only the card owner can update their own duo card
      allow update: if request.auth != null
                    && resource.data.userId == request.auth.uid
                    && request.resource.data.userId == request.auth.uid;

      // Only the card owner can delete their own duo card
      allow delete: if request.auth != null
                    && resource.data.userId == request.auth.uid;
    }

    // Reports collection - post reports from users
    match /reports/{reportId} {
      // Admin can read all reports; regular users cannot
      allow read: if request.auth != null
                  && request.auth.uid == 'VljkZhdkF3gCQI0clVkbQ0XCIxp1';

      // Any authenticated user can create a report
      allow create: if request.auth != null
                    && request.resource.data.reporterId == request.auth.uid
                    && request.resource.data.reason in ['spam', 'harassment', 'inappropriate', 'other']
                    && request.resource.data.status == 'pending'
                    && request.resource.data.createdAt is timestamp;

      // Only admin can update report status
      allow update: if request.auth != null
                    && request.auth.uid == 'VljkZhdkF3gCQI0clVkbQ0XCIxp1';
    }
    
    // Presence collection - online status tracking
      match /presence/{userId} {
        allow read: if request.auth != null;
        allow write: if request.auth != null && request.auth.uid == userId;
      }

    // Waitlist collection - landing-page email signups
    // Written directly from the client by unauthenticated visitors, so create
    // is open but tightly shaped: exactly an email + createdAt, nothing else.
    // Never readable from the client — it holds unverified personal emails.
    match /waitlist/{id} {
      allow create: if request.resource.data.keys().hasOnly(['email', 'createdAt'])
                    && request.resource.data.email is string
                    && request.resource.data.email.size() > 0
                    && request.resource.data.email.size() <= 320
                    && request.resource.data.createdAt is timestamp;

      allow read, update, delete: if false;
    }

    // Match caches - written only by the getRecentMatches function via the
    // Admin SDK (which bypasses these rules). Denied to clients: they hold
    // other players' PUUIDs and identities, and clients read match history
    // through the callable, never directly.
    //
    // riotMatchCache holds immutable match-v5 payloads (no TTL - a finished
    // match never changes). The two id/list caches carry a short TTL, since
    // which matches a player has played does change.
    match /riotMatchCache/{matchId} {
      allow read, write: if false;
    }

    match /riotMatchIdCache/{key} {
      allow read, write: if false;
    }

    match /valorantMatchCache/{key} {
      allow read, write: if false;
    }

    // Rate-limit state for getRecentMatches. Server-owned: a client that could
    // write here could lift its own limit.
    match /matchRefreshThrottle/{key} {
      allow read, write: if false;
    }

    match /matchHistoryAnonRate/{ip} {
      allow read, write: if false;
    }

    // Default: deny all other access
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
